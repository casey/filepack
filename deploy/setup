#!/usr/bin/env bash

# This script is idempotent.

set -euxo pipefail

DOMAIN=$1

export DEBIAN_FRONTEND=noninteractive

touch ~/.hushlogin

hostnamectl set-hostname $DOMAIN

apt-get install --yes \
  acl \
  clang \
  curl \
  locales-all \
  ufw \
  unattended-upgrades \
  vim

apt-get remove --yes --auto-remove

if [[ -e /var/run/reboot-required ]]; then
  echo 'error: reboot required' >&2
  exit 1
fi

cp deploy/20auto-upgrades /etc/apt/apt.conf.d

cp deploy/00-authentication.conf /etc/ssh/sshd_config.d
sshd -t
sshd -T | grep --line-regexp 'passwordauthentication no'
systemctl restart sshd

ufw default allow outgoing
ufw default deny incoming

ufw allow http
ufw allow https
ufw allow ssh

ufw --force enable

cp deploy/90-network.conf /etc/sysctl.d
sysctl --system

id --user build || useradd --create-home build

rsync \
  --archive \
  --chown build:build \
  --delete \
  --exclude /.git \
  --exclude /target \
  . \
  /home/build/filepack

runuser --login build --command 'cd filepack && ./deploy/build'

install --backup /home/build/filepack/target/release/filepack /usr/local/bin/filepack

id --user filepack || useradd --system filepack

cp deploy/filepack.service /etc/systemd/system/
systemctl daemon-reload
systemctl enable filepack
systemctl restart filepack

while ! curl --fail https://$DOMAIN/ > /dev/null; do
  echo "Waiting for filepack at https://$DOMAIN/…"
  sleep 1
done
