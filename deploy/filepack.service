[Unit]
After=network.target
Description=Filepack server
StartLimitBurst=120
StartLimitIntervalSec=10m

[Service]
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=FILEPACK_DATA_DIR=/var/lib/filepack
Environment=FILEPACK_LOG=info
Environment=RUST_BACKTRACE=1
ExecStart=/usr/local/bin/filepack \
  serve \
  --acme-contact mailto:casey@rodarmor.com \
  --admin-key public1a0475c817831f46c25109908a081cf091bb127e0ea47dba3829a3da003dbec0b2c \
  --domain filepack.com \
  --http \
  --https \
  --redirect www.filepack.com \
  --redirect-http-to-https \
  --restrict-writes
Group=filepack
LimitNOFILE=65536
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
Restart=on-failure
RestartSec=5s
StateDirectory=filepack
StateDirectoryMode=0700
TimeoutStopSec=10m
Type=exec
User=filepack
WorkingDirectory=/var/lib/filepack

[Install]
WantedBy=multi-user.target
